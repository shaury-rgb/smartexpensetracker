# ==============================================================================
# Smart Expense Tracker - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application or Docker Compose:
#   cp .env.example .env
# Never commit actual secret keys or production passwords to version control.

# Application Server
PORT=8080

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense_tracker
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Full JDBC URL (optional override)
DB_URL=jdbc:postgresql://localhost:5432/expense_tracker

# JWT Authentication
# In production, specify a secure random 256-bit (or 512-bit) base64-encoded key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
